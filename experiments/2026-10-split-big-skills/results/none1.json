 {
  "id": "pymatgen#6",
  "skill": "pymatgen",
  "cond": "none",
  "answer": "Use pymatgen.symmetry.analyzer.SpacegroupAnalyzer. Create sga = SpacegroupAnalyzer(structure), then call sga.get_space_group_symbol() and sga.get_space_group_number().",
