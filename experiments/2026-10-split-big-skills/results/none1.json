 {
  "id": "rdkit#12",
  "skill": "rdkit",
  "cond": "none",
  "answer": "Use RDKit: AllChem.EmbedMultipleConfs(mol, numConfs=10, randomSeed=42, clearConfs=True). For modern ETKDG, pass params=AllChem.ETKDGv3() and set randomSeed on the params object or as the function argument.",
  "opened": [],
  "chars": 0,
  "reached": false,
  "correct": true
 },
 {
  "id": "rdkit#13",
  "skill": "rdkit",
  "cond": "none",
  "answer": "Use RDKit: AllChem.MMFFOptimizeMoleculeConfs(mol, mmffVariant='MMFF94') optimizes all conformers and returns (converged, energy) per conformer. Alternatively, loop over conformer IDs and call AllChem.MMFFOptimizeMolecule(mol, confId=i, mmffVariant='MMFF94').",
  "opened": [],
  "chars": 0,
  "reached": false,
  "correct": true
 },
